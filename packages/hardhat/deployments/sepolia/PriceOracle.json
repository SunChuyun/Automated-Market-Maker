  "metadata": "{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_priceFeed\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"_maxAge\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"getEthUsdPrice18\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"getEthUsdPriceWithStatus18\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"maxAge\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"priceFeed\",\"outputs\":[{\"internalType\":\"contract IAggregatorV3\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"project/contracts/PriceOracle.sol\":\"PriceOracle\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\"project/:@openzeppelin/contracts/=npm/@openzeppelin/contracts@5.7.0/\",\"project/:hardhat/=npm/hardhat@3.20.0/\"]},\"sources\":{\"project/contracts/PriceOracle.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity ^0.8.20;\\n\\n// Minimal Chainlink-compatible interface\\ninterface IAggregatorV3 {\\n    function decimals() external view returns (uint8);\\n\\n    function latestRoundData()\\n        external\\n        view\\n        returns (\\n            uint80 roundId,\\n            int256 answer,\\n            uint256 startedAt,\\n            uint256 updatedAt,\\n            uint80 answeredInRound\\n        );\\n}\\n\\ncontract PriceOracle {\\n    IAggregatorV3 public immutable priceFeed;\\n\\n    // Maximum allowed age of the oracle price\\n    uint256 public immutable maxAge;\\n\\n    constructor(address _priceFeed, uint256 _maxAge) {\\n        require(_priceFeed != address(0), \\\"Invalid price feed\\\");\\n        require(_maxAge > 0, \\\"Invalid max age\\\");\\n\\n        priceFeed = IAggregatorV3(_priceFeed);\\n        maxAge = _maxAge;\\n    }\\n\\n    // Strict read for finalizing initial configuration and price comparisons.\\n    function getEthUsdPrice18() external view returns (uint256) {\\n        (uint256 price18, bool fresh) = getEthUsdPriceWithStatus18();\\n        require(fresh, \\\"Stale oracle price\\\");\\n        return price18;\\n    }\\n\\n    // A stale / temporarily unavailable feed is not a malformed feed.\\n    // Report stale/unavailable as fresh=false so AMMPool can trade using\\n    // spot-vs-TWAP. Malformed returned data must still fail closed.\\n    function getEthUsdPriceWithStatus18() public view returns (uint256, bool) {\\n        try priceFeed.latestRoundData() returns (\\n            uint80,\\n            int256 answer,\\n            uint256,\\n            uint256 updatedAt,\\n            uint80\\n        ) {\\n            require(answer > 0, \\\"Invalid oracle price\\\");\\n            require(updatedAt > 0 && updatedAt <= block.timestamp, \\\"Invalid oracle timestamp\\\");\\n\\n            uint8 feedDecimals;\\n            try priceFeed.decimals() returns (uint8 decimals_) {\\n                feedDecimals = decimals_;\\n            } catch {\\n                return (0, false);\\n            }\\n            require(feedDecimals <= 18, \\\"Unsupported oracle decimals\\\");\\n\\n            // Guard multiplication overflow even on unexpected mock feeds.\\n            uint256 factor = 10 ** (18 - feedDecimals);\\n            require(uint256(answer) <= type(uint256).max / factor, \\\"Oracle price overflow\\\");\\n            uint256 price18 = uint256(answer) * factor;\\n            bool fresh = block.timestamp - updatedAt <= maxAge;\\n            return (price18, fresh);\\n        } catch {\\n            // Chainlink call reverted (RPC/feed temporarily unavailable).\\n            return (0, false);\\n        }\\n    }\\n}\\n\",\"keccak256\":\"0xa0ef44c3b16d994dd4aa8ed8e09cb49a849b7378ae4b2a44af92b28f02e36296\",\"license\":\"MIT\"}},\"version\":1}",
